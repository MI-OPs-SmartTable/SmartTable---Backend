################################################################################
# SmartTable Backend — variables de entorno (.env.example)
#
# Copia este archivo a `.env` y completa los valores.
# En Electron, muchas de estas las inyecta el proceso (main.cjs) y pisan o
# complementan este archivo. En API sola (npm start), se leen desde aquí.
################################################################################

# =============================================================================
# Entorno y seguridad
# =============================================================================

# Modo de ejecución: DEVELOPMENT | PRODUCTION (también acepta typo "enviroment").
# Para: elegir qué JWT_SECRET_* usar y endurecer/relajar rutas de prueba.
# Si falta: se trata como DEVELOPMENT.
# También acepta NODE_ENV=production → PRODUCTION.
environment=DEVELOPMENT

# Secreto JWT en DEVELOPMENT.
# Para: firmar tokens cuando environment=DEVELOPMENT.
# Si falta: usa JWT_SECRET genérico si existe; si no, auth puede fallar al firmar/verificar.
JWT_SECRET_DEVELOPMENT=change-me-in-development

# Secreto JWT en PRODUCTION.
# Para: firmar tokens cuando environment=PRODUCTION (Electron fuerza PRODUCTION).
# Si falta: usa JWT_SECRET genérico si existe; Electron inyecta un fallback si viene vacío.
JWT_SECRET_PRODUCTION=change-me-in-production

# (Opcional) Secreto único si no separas DEV/PROD.
# JWT_SECRET=

# Caducidad del token de login (jsonwebtoken).
# Para: cuánto dura la sesión.
# Si falta: fallback "8h"
# JWT_EXPIRES_IN=8h

# =============================================================================
# Servidor HTTP
# =============================================================================

# Puerto del API.
# Para: escuchar peticiones (Swagger, front, Electron).
# Si falta: fallback 8080
PORT=8080

# Orígenes CORS permitidos (lista separada por comas).
# Para: permitir el front en Vite (5173) u otros orígenes.
# Si falta: fallback "http://localhost:3030,http://localhost:5173"
# En Electron desktop:dev se suele inyectar "http://localhost:5173,http://localhost:8080"
CORS_ORIGIN=http://localhost:5173,http://localhost:3030

# =============================================================================
# Base de datos y archivos locales
# =============================================================================

# Ruta al archivo SQLite (pos.db).
# Para: dónde vive la BD.
# Si falta: fallback a api/pos.db (junto al código del backend).
# En Electron: se inyecta a AppData/.../pos.db (no uses la del repo en desktop).
# DB_PATH=

# Ruta al backup-config.json (intervalo Drive, folder id, etc.).
# Para: persistir config de respaldo.
# Si falta: se guarda junto a la BD (misma carpeta que DB_PATH).
# En Electron: AppData/.../backup-config.json
# CONFIG_PATH=

# Carpeta de copias locales .db.gz.
# Para: dónde escribir el respaldo físico.
# Si falta: carpeta "backups" junto a la BD.
# En Electron: AppData/.../backups
# BACKUP_LOCAL_DIR=

# Ruta del archivo de tokens OAuth del cliente (refresh_token tras "Conectar con Google").
# Para: guardar la sesión Google del cliente (NO es el JSON del proveedor).
# Si falta: <dir_de_la_bd>/credentials/google-service-account.json
# En Electron: AppData/.../credentials/google-service-account.json
# GOOGLE_DRIVE_CREDENTIALS_PATH=

# Si es "1", al arrancar con BD vacía ejecuta seeds (usuarios iniciales, etc.).
# Para: primer arranque usable sin migrar a mano.
# Si falta / no es 1: no hace seed automático.
# Electron siempre inyecta SMARTTABLE_AUTO_SEED=1
# SMARTTABLE_AUTO_SEED=1

# Carpeta dist del frontend para servir UI desde el mismo Express (build empaquetado).
# Para: abrir la app en http://127.0.0.1:PORT sin Vite.
# Si falta: el backend solo expone API (no sirve el SPA).
# Electron empaquetado la inyecta (FRONTEND_DIST).
# FRONTEND_DIST=

# =============================================================================
# Google Drive OAuth (cliente OAuth del PROVEEDOR, quemado en la instalación)
# =============================================================================
# Prioridad:
#   1) GOOGLE_OAUTH_CLIENT_ID + GOOGLE_OAUTH_CLIENT_SECRET
#   2) GOOGLE_OAUTH_CLIENT_PATH → lee client_id/secret del JSON de Cloud Console
# Si no hay ninguna: no se puede "Conectar con Google"; Drive cloud queda inactivo.
# En Electron: conviene definirlas también en el .env del Frontend (se pasan al hijo).

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Alternativa: ruta al JSON OAuth (installed/web). Se ignora si ID+SECRET están puestos.
# GOOGLE_OAUTH_CLIENT_PATH=

# URI de redirección del callback OAuth.
# Para: a dónde vuelve Google tras autorizar.
# Si falta: http://127.0.0.1:${PORT}/api/backup/oauth/callback
# Debe coincidir con la URI autorizada en Cloud Console (cliente Web).
# GOOGLE_OAUTH_REDIRECT_URI=
